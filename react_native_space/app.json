{
  "expo": {
    "name": "Betting Analyzer",
    "slug": "betting-analyzer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "description": "Análisis profesional de apuestas deportivas con Expected Value (EV+)",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bettinganalyzer.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app no usa la cámara",
        "NSPhotoLibraryUsageDescription": "Esta app no accede a la galería"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.bettinganalyzer.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "REEMPLAZA_CON_TU_PROJECT_ID"
      }
    },
    "owner": "tu-username-expo",
    "updates": {
      "url": "https://u.expo.dev/REEMPLAZA_CON_TU_PROJECT_ID"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
